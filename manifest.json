{
  "manifest_version": 3,
  "name": "No Video Loop",
  "version": "1.14.0",
  "description": "Stops Facebook, Instagram and YouTube videos from looping. Stops the Facebook feed auto-refreshing. On Instagram, also disables autoplay, plays feed videos in place and keeps them playing in background tabs.",
  "background": {
    "service_worker": "src/background/keep-tabs-loaded.js"
  },
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "src/core.js",
        "src/block-loop.js",
        "src/stop-restart.js",
        "src/stop-near-end.js",
        "src/always-visible.js",
        "src/always-focused.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "css": [
        "src/instagram/show-whole-video.css"
      ],
      "js": [
        "src/core.js",
        "src/block-loop.js",
        "src/stop-restart.js",
        "src/stop-near-end.js",
        "src/always-visible.js",
        "src/always-focused.js",
        "src/user-loop.js",
        "src/instagram/no-autoplay.js",
        "src/ui/overlay-button.js",
        "src/ui/geometry.js",
        "src/ui/watch-videos.js",
        "src/instagram/play-button.js",
        "src/instagram/loop-button.js",
        "src/instagram/inline-playback.js",
        "src/instagram/no-likes-list.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "exclude_matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/core.js",
        "src/block-loop.js",
        "src/stop-restart.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}

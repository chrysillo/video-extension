{
  "manifest_version": 3,
  "name": "No Video Loop",
  "version": "1.6.0",
  "description": "Stops Facebook, Instagram and YouTube videos from looping. Stops the Facebook feed auto-refreshing. On Instagram, also disables autoplay and plays feed videos in place.",
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "src/core.js",
        "src/block-loop.js",
        "src/stop-restart.js",
        "src/stop-near-end.js",
        "src/facebook/no-auto-refresh.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "css": [
        "src/instagram/show-whole-video.css"
      ],
      "js": [
        "src/core.js",
        "src/block-loop.js",
        "src/stop-restart.js",
        "src/stop-near-end.js",
        "src/instagram/no-autoplay.js",
        "src/instagram/inline-playback.js",
        "src/instagram/no-likes-list.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "exclude_matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/core.js",
        "src/block-loop.js",
        "src/stop-restart.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}

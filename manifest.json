{
  "manifest_version": 3,
  "name": "No Video Loop",
  "version": "1.20.5",
  "description": "Stops Facebook, Instagram, YouTube and X (Twitter) videos from looping. Stops the Facebook feed auto-refreshing. Stops double-clicks liking Instagram posts. On Facebook and Instagram, also disables autoplay, plays feed videos in place and keeps them playing in background tabs.",
  "action": {
    "default_title": "No Video Loop",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/keep-tabs-loaded.js"
  },
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "src/core.js",
        "src/block-loop.js",
        "src/stop-restart.js",
        "src/stop-near-end.js",
        "src/always-visible.js",
        "src/always-focused.js",
        "src/no-autoplay.js",
        "src/inline-playback.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "css": [
        "src/instagram/show-whole-video.css"
      ],
      "js": [
        "src/core.js",
        "src/block-loop.js",
        "src/stop-restart.js",
        "src/stop-near-end.js",
        "src/always-visible.js",
        "src/always-focused.js",
        "src/user-loop.js",
        "src/no-autoplay.js",
        "src/ui/overlay-button.js",
        "src/ui/geometry.js",
        "src/ui/watch-videos.js",
        "src/instagram/play-button.js",
        "src/ui/loop-button.js",
        "src/inline-playback.js",
        "src/instagram/no-likes-list.js",
        "src/instagram/no-double-click-like.js",
        "src/instagram/no-profile-hover-card.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "exclude_matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/core.js",
        "src/block-loop.js",
        "src/youtube/allow-user-loop.js",
        "src/stop-restart.js",
        "src/youtube/shorts-no-loop.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "js": [
        "src/core.js",
        "src/block-loop.js",
        "src/stop-restart.js",
        "src/stop-near-end.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
